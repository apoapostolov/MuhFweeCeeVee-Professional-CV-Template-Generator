# OpenRouter API key (required for AI scoring, research, and SYNC translation)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: require token on mutation/analysis/export API routes when exposing beyond localhost.
# Loopback (localhost / 127.0.0.1) browser UI remains trusted without sending the token.
# Non-loopback clients must send Authorization: Bearer … or x-mfcv-api-token.
# MFCV_API_TOKEN=generate_a_long_random_secret

# Optional: force token configuration (503 if MFCV_API_TOKEN is missing)
# MFCV_REQUIRE_API_TOKEN=true

# Optional: max concurrent Playwright PDF/PNG exports (default 1)
# MFCV_EXPORT_CONCURRENCY=1

# Optional: parser service host/port overrides can be added here if needed.
